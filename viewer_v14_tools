<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>AlphaFind + PANTHER + Pfam + protein notes Viewer</title>
  <!-- viewer_v12: v11 + shared Mol* workspace + TM-align compare -->

  <script src="https://cdn.jsdelivr.net/npm/d3@7"></script>

  <style>
    body {
      margin: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: #222;
      background: white;
    }

    #app {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 350px;
      height: 100vh;
    }

    #main {
      display: flex;
      flex-direction: column;
      min-width: 0;
      min-height: 0;
      height: 100vh;
      overflow: hidden;
    }

    #toolbar {
      display: flex;
      gap: 8px;
      align-items: center;
      padding: 10px 12px;
      border-bottom: 1px solid #ddd;
      background: #fafafa;
      flex-wrap: wrap;
    }

    button,
    select,
    input[type="number"] {
      padding: 6px 10px;
      border: 1px solid #bbb;
      border-radius: 6px;
      background: white;
      font: inherit;
    }

    input[type="number"] {
      width: 72px;
    }

    .toolbar-check {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 12px;
      color: #555;
      white-space: nowrap;
    }

    button {
      cursor: pointer;
    }

    button:hover {
      background: #f0f0f0;
    }

    button:disabled {
      opacity: 0.4;
      cursor: default;
    }

    .toolbar-group {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding-left: 8px;
      border-left: 1px solid #ddd;
    }

    .toolbar-label {
      font-size: 12px;
      color: #666;
    }

    #breadcrumb {
      flex: 1;
      min-width: 220px;
      font-size: 13px;
      color: #555;
    }

    .breadcrumb-item {
      cursor: pointer;
      text-decoration: underline;
      text-decoration-color: #ccc;
    }

    .breadcrumb-item:hover {
      color: #b00000;
    }

    #status {
      color: #777;
      font-size: 13px;
      white-space: nowrap;
    }

    #tree-wrap {
      flex: 1 1 auto;
      height: 0;
      min-height: 0;
      position: relative;
      overflow: auto;
      background: white;
      cursor: grab;
      user-select: none;
      touch-action: none;
      overscroll-behavior: contain;
    }

    #tree-wrap.dragging {
      cursor: grabbing;
    }

    svg {
      display: block;
      min-width: 100%;
      min-height: 100%;
    }

    .link {
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .link.context {
      stroke: #c2c2c2;
      stroke-width: 1.6;
    }

    .link.path {
      stroke: #e24a3b;
      stroke-width: 2.2;
    }

    .link.hit {
      stroke: #990000;
      stroke-width: 3;
    }

    .node-hitbox {
      fill: transparent !important;
      stroke: none !important;
      pointer-events: all;
    }

    /*
      Vnější barevný disk = hodnota TM-score.
      Vnitřní tmavý disk zůstává neutrální, aby bílé + / − bylo dobře vidět.
    */
    .score-ring {
      stroke: none !important;
      pointer-events: none;
    }

    /*
      PANTHER evidence = barevný obrys kolem TM-score disku.
      TM-score tak zůstává zachovaný uvnitř:
      - světle modrá = člen celé PANTHER family
      - tmavě modrá = člen stejné subfamily jako query
      - fialová = přímý AlphaFind hit + PANTHER evidence ve stejném taxonu
    */
    .evidence-ring {
      fill: none !important;
      stroke-width: 4px !important;
      pointer-events: none;
    }

    .evidence-ring.panther-family {
      stroke: #78b7e5 !important;
    }

    .evidence-ring.panther-subfamily {
      stroke: #175a9c !important;
    }

    .evidence-ring.both {
      stroke: #8e44ad !important;
    }

    /* Pfam evidence = samostatný zelený čtvereček vedle uzlu. */
    .pfam-marker {
      fill: #2e8b57;
      stroke: white;
      stroke-width: 1.5px;
      pointer-events: none;
    }

    .pfam-key {
      width: 11px;
      height: 11px;
      display: inline-block;
      background: #2e8b57;
      border-radius: 2px;
      flex: 0 0 auto;
    }

    .visible-circle {
      fill: #333 !important;
    }

    .node circle {
      stroke: white;
      stroke-width: 1.5;
    }

    .node.context circle:not(.score-ring):not(.visible-circle):not(.node-hitbox) {
      fill: #aaa;
    }

    .node.path circle:not(.score-ring):not(.visible-circle):not(.node-hitbox) {
      fill: #e24a3b;
    }

    .node.hit circle:not(.score-ring):not(.visible-circle):not(.node-hitbox) {
      fill: #990000;
    }

    .node.expandable .visible-circle {
      stroke: #222;
      stroke-width: 2.6;
      cursor: pointer;
    }

    .node text {
      font-size: 12px;
      dominant-baseline: middle;
      paint-order: stroke;
      stroke: white;
      stroke-width: 4px;
      stroke-linejoin: round;
      pointer-events: none;
    }

    .node.path text,
    .node.hit text {
      font-weight: 600;
    }

    .expand-mark {
      font-size: 14px !important;
      font-weight: 900;
      text-anchor: middle;
      dominant-baseline: middle;
      pointer-events: none;
      fill: white;
      stroke: none !important;
      paint-order: normal !important;
    }

    .center-node circle {
      stroke: #222;
      stroke-width: 2.5;
    }

    .center-label {
      font-size: 15px;
      font-weight: 700;
      paint-order: stroke;
      stroke: white;
      stroke-width: 4px;
    }

    #side {
      border-left: 1px solid #ddd;
      padding: 16px;
      overflow: auto;
      background: #fbfbfb;
    }

    #side h2 {
      margin-top: 0;
      font-size: 18px;
    }

    .muted {
      color: #777;
    }

    .info-row {
      margin: 10px 0;
    }

    .info-label {
      color: #666;
      font-size: 12px;
      text-transform: uppercase;
    }

    .info-value {
      margin-top: 2px;
      font-size: 15px;
      word-break: break-word;
    }

    .score-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 7px 12px;
      margin-top: 6px;
      font-size: 13px;
    }

    .hits-list {
      margin: 8px 0 0 0;
      padding-left: 20px;
      font-size: 13px;
    }

    .hits-list li {
      margin: 6px 0;
    }

    .protein-id-draggable {
      display: inline-block;
      cursor: grab;
      padding: 1px 4px;
      margin-left: -4px;
      border-radius: 4px;
      border: 1px dashed transparent;
      user-select: text;
    }

    .protein-id-draggable:hover {
      background: #eef6ff;
      border-color: #7aa7d9;
    }

    .protein-id-draggable:active {
      cursor: grabbing;
    }

    .mol-hint {
      margin-top: 6px;
      font-size: 11px;
      color: #777;
    }

    .side-action {
      width: 100%;
      margin-top: 12px;
    }

    #legend {
      margin-top: 22px;
      padding-top: 14px;
      border-top: 1px solid #ddd;
    }

    .legend-row {
      display: flex;
      gap: 8px;
      align-items: center;
      margin: 7px 0;
      font-size: 13px;
    }

    .dot {
      width: 11px;
      height: 11px;
      border-radius: 50%;
      display: inline-block;
      flex: 0 0 auto;
    }

    .dot.context { background: #aaa; }
    .dot.panther-family { background: #78b7e5; }
    .dot.panther-subfamily { background: #175a9c; }
    .dot.both { background: #8e44ad; }

    .tm-legend {
      margin-top: 12px;
      font-size: 12px;
      color: #555;
    }

    .tm-gradient {
      height: 12px;
      margin-top: 6px;
      border-radius: 999px;
      border: 1px solid #bbb;
      background: linear-gradient(
        to right,
        #f4df4e 0%,
        #f5a43a 45%,
        #e4572e 70%,
        #b71c1c 100%
      );
    }

    .tm-legend-labels {
      display: flex;
      justify-content: space-between;
      margin-top: 3px;
      font-size: 11px;
      color: #777;
    }

    #error {
      position: absolute;
      inset: 20px;
      display: none;
      padding: 16px;
      background: #fff3f3;
      border: 1px solid #d88;
      border-radius: 8px;
      white-space: pre-wrap;
      overflow: auto;
    }


    input[type="text"] {
      padding: 6px 10px;
      border: 1px solid #bbb;
      border-radius: 6px;
      background: white;
      font: inherit;
    }

    #organism-search {
      width: 190px;
    }

    #annotation-name {
      width: 160px;
    }

    #annotation-color {
      width: 34px;
      height: 30px;
      padding: 2px;
      border: 1px solid #bbb;
      border-radius: 6px;
      background: white;
      cursor: pointer;
    }

    .annotation-marker {
      stroke: white;
      stroke-width: 1.2;
      pointer-events: none;
    }

    .annotation-mode-active {
      background: #fff4cc !important;
      border-color: #d6a400 !important;
    }

    .search-highlight {
      stroke: #111;
      stroke-width: 3;
      fill: none;
      pointer-events: none;
    }

    .annotation-summary {
      display: inline-flex;
      gap: 5px;
      flex-wrap: wrap;
      margin-top: 5px;
    }

    .annotation-chip {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 2px 7px;
      border: 1px solid #ddd;
      border-radius: 999px;
      font-size: 11px;
      background: #fafafa;
    }

    .annotation-chip-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      display: inline-block;
    }


    .taxon-note-box {
      width: 100%;
      min-height: 110px;
      box-sizing: border-box;
      resize: vertical;
      padding: 8px 10px;
      border: 1px solid #c9c9c9;
      border-radius: 7px;
      font: inherit;
      line-height: 1.35;
      background: #fffef8;
    }

    .taxon-note-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 7px;
      flex-wrap: wrap;
    }

    .taxon-note-status {
      font-size: 11px;
      color: #666;
    }



    #compare-selection-summary {
      display: inline-flex;
      gap: 5px;
      align-items: center;
      max-width: 430px;
      flex-wrap: wrap;
    }

    .compare-chip {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 7px;
      border: 1px solid #c9d6e2;
      border-radius: 999px;
      background: #f4f8fc;
      font-size: 11px;
      max-width: 200px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .compare-hit-label {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      margin-left: 7px;
      font-size: 11px;
      color: #456;
      white-space: nowrap;
    }

    .compare-hit-label input {
      margin: 0;
    }

    .compare-query-label {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      margin-left: 4px;
      font-size: 11px;
      color: #456;
      white-space: nowrap;
    }

    .compare-query-label input {
      margin: 0;
    }

    .protein-hit {
      padding: 8px 0 10px 0;
      border-bottom: 1px solid #eceff3;
    }

    .protein-hit:last-child {
      border-bottom: 0;
    }

    .protein-meta {
      margin-top: 4px;
      font-size: 12px;
      color: #334155;
      line-height: 1.45;
    }

    .protein-tools-row {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
      margin-top: 6px;
      margin-bottom: 4px;
    }

    .protein-chips {
      margin-top: 6px;
    }

    .protein-short-label-input {
      min-width: 230px;
      flex: 1 1 240px;
      padding: 5px 8px;
      border: 1px solid #c9c9c9;
      border-radius: 6px;
      font: inherit;
      background: #fffef8;
    }

    .protein-note-details {
      margin-top: 6px;
      padding: 6px 8px;
      background: #fffef8;
      border: 1px solid #eadfb8;
      border-radius: 8px;
    }

    .protein-note-details summary {
      cursor: pointer;
      color: #6b5b18;
      font-size: 12px;
      user-select: none;
    }

    .protein-long-note-textarea {
      width: 100%;
      min-height: 90px;
      box-sizing: border-box;
      resize: vertical;
      margin-top: 7px;
      padding: 8px 10px;
      border: 1px solid #c9c9c9;
      border-radius: 7px;
      font: inherit;
      line-height: 1.35;
      background: #fff;
    }

    .protein-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 7px;
    }

    .protein-tag-btn,
    .protein-note-save-btn,
    .protein-note-clear-btn,
    .protein-link-btn {
      padding: 4px 8px;
      border: 1px solid #c8d2dc;
      border-radius: 6px;
      background: #fff;
      cursor: pointer;
      font: inherit;
      font-size: 12px;
      text-decoration: none;
      color: #1f2937;
    }

    .protein-link-btn {
      display: inline-flex;
      align-items: center;
    }

    .protein-tag-btn:hover,
    .protein-note-save-btn:hover,
    .protein-note-clear-btn:hover,
    .protein-link-btn:hover {
      background: #eef6ff;
    }

    .protein-tag-btn:disabled {
      cursor: not-allowed;
      opacity: 0.55;
      background: #f5f5f5;
    }

    .protein-filter-row {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 8px;
      font-size: 12px;
      color: #556070;
    }

    .protein-filter-row select {
      min-width: 180px;
    }

    .protein-note-status {
      font-size: 11px;
      color: #666;
    }

    @media (max-width: 900px) {
      #app {
        grid-template-columns: 1fr;
        grid-template-rows: minmax(0, 1fr) auto;
      }

      #side {
        border-left: 0;
        border-top: 1px solid #ddd;
        max-height: 36vh;
      }
    }
  </style>
</head>

<body>
<div id="app">
  <div id="main">
    <div id="toolbar">
      <button id="overview-btn">Celkový přehled</button>
      <button id="collapse-btn">Sbalit vše</button>
      <button id="back-btn">← Zpět</button>
      <button id="mol-workspace-btn" title="Otevře samostatné Mol* okno pro přetahování UniProt ID">🧬 Mol* workspace</button>

      <div class="toolbar-group" id="compare-tools">
        <span class="toolbar-label">Compare:</span>
        <span id="compare-selection-summary"><span class="muted">vyber 2 proteiny</span></span>
        <button id="compare-btn" type="button" disabled title="Superponuje dva vybrané proteiny v samostatném Mol* okně">Compare</button>
        <button id="compare-clear-btn" type="button" title="Zruší výběr pro Compare">×</button>
        <label class="compare-query-label" title="Přidat jako referenci přímo query protein projektu">
          <input id="compare-query-checkbox" type="checkbox" />
          query
        </label>
      </div>

      <div class="toolbar-group">
        <span class="toolbar-label">Projekt:</span>
        <select id="project-select">
          <option value="">Načítám projekty…</option>
        </select>
      </div>

      <div class="toolbar-group">
        <span class="toolbar-label">Zobrazení:</span>
        <select id="view-filter">
          <option value="hits" selected>Jen evidence</option>
          <option value="panther">Jen PANTHER family</option>
          <option value="pfam">Jen Pfam family</option>
          <option value="alpha-only">Jen AlphaFind hity mimo PANTHER family</option>
          <option value="alpha-outside-pfam">Jen AlphaFind hity mimo Pfam family</option>
          <option value="context">Evidence + kontext</option>
        </select>
      </div>

      <div class="toolbar-group">
        <span class="toolbar-label">Názvy:</span>
        <select id="label-mode">
          <option value="latin" selected>Latina</option>
          <option value="cs-latin">Čeština + latina</option>
        </select>
      </div>

      <div class="toolbar-group">
        <label class="toolbar-check" title="Po zapnutí zůstanou jako AlphaFind evidence jen hity, které splní zvolený práh.">
          <input id="score-filter-enabled" type="checkbox" />
          Filtrovat hity
        </label>
        <select id="score-filter-metric" title="Metrika pro filtrování AlphaFind hitů">
          <option value="tm" selected>TM-score</option>
          <option value="aligned">Aligned residues</option>
          <option value="identity">Sequence identity</option>
        </select>
        <span class="toolbar-label">≥</span>
        <input id="score-filter-threshold" type="number" min="0" max="1" step="0.01" value="0.70" title="Minimální hodnota pro zobrazení hitu" />
      </div>


      <div class="toolbar-group">
        <span class="toolbar-label">Organismus:</span>
        <input id="organism-search" type="text" list="organism-search-list"
               placeholder="latinsky nebo česky…" autocomplete="off" />
        <datalist id="organism-search-list"></datalist>
        <button id="organism-search-btn" title="Najde taxon, rozbalí jeho větev a otevře detail">Najít</button>
        <button id="organism-search-clear-btn" title="Zruší zvýraznění hledaného taxonu">×</button>
      </div>

      <div class="toolbar-group" id="annotation-tools">
        <label class="toolbar-check" title="V režimu označování kliknutím přiřadíš aktivní štítek taxonu. Další kliknutí jej zase odebere.">
          <input id="annotation-mode" type="checkbox" />
          Režim štítků
        </label>
        <select id="annotation-active" title="Aktivní uložený štítek">
          <option value="">— žádný štítek —</option>
        </select>
        <input id="annotation-name" type="text" placeholder="nový štítek…" />
        <input id="annotation-color" type="color" value="#2f80ed" title="Barva štítku" />
        <button id="annotation-save-btn" title="Uloží nový štítek nebo přejmenuje aktivní">Uložit</button>
        <button id="annotation-delete-btn" title="Smaže aktivní štítek a jeho přiřazení">Smazat</button>
        <span class="toolbar-label">Filtrovat štítkem:</span>
        <select id="annotation-filter">
          <option value="">bez filtru</option>
        </select>
      </div>

      <div class="toolbar-group">
        <span class="toolbar-label">Barvit podle:</span>
        <select id="color-metric">
          <option value="tm" selected>TM-score</option>
          <option value="aligned">Aligned residues</option>
          <option value="identity">Sequence identity</option>
        </select>
      </div>

      <div id="breadcrumb"></div>
      <span id="status"></span>
    </div>

    <div id="tree-wrap">
      <svg id="tree"></svg>
      <div id="error"></div>
    </div>
  </div>

  <aside id="side">
    <h2>Taxon</h2>

    <div id="info">
      <p class="muted">Klikni na uzel ve stromu.</p>
    </div>

    <div id="legend">
      <strong>Legenda</strong>

      <div class="tm-legend">
        <div id="score-legend-title">
          Barva vnějšího kolečka = nejlepší TM-score v celé větvi pod tímto taxonem
        </div>

        <div class="tm-gradient"></div>

        <div class="tm-legend-labels" id="score-legend-labels">
          <span>0.50</span>
          <span>0.60</span>
          <span>0.70</span>
          <span>0.80</span>
          <span>0.90</span>
          <span>1.00</span>
        </div>
      </div>

      <div class="legend-row" style="margin-top:14px;">
        <span class="dot panther-family"></span>
        PANTHER family member
      </div>

      <div class="legend-row">
        <span class="dot panther-subfamily"></span>
        Stejná PANTHER subfamily jako query
      </div>

      <div class="legend-row">
        <span class="dot both"></span>
        Přímý AlphaFind hit + PANTHER
      </div>

      <div class="legend-row">
        <span class="pfam-key"></span>
        Pfam family member
      </div>

      <div class="legend-row">
        <span class="dot context"></span>
        Taxonomický kontext bez přímé evidence
      </div>

      <p class="muted" id="panther-coverage-note" style="font-size:12px;">
        PANTHER evidence se načte, pokud je pro projekt dostupná.
      </p>

      <p class="muted" id="pfam-coverage-note" style="font-size:12px;">
        Pfam evidence se načte, pokud je pro projekt dostupná.
      </p>

      <p class="muted" id="score-legend-note" style="font-size:12px;">
        Žlutá = nižší hodnota, oranžová = střední, červená = vysoká.
        U nadřazeného taxonu se použije nejlepší hodnota z aktuálně
        zobrazených AlphaFind hitů v jeho podstromu.
        Bílé + znamená „lze rozbalit“, bílé − znamená „je rozbaleno“.
      </p>
    </div>
  </aside>
</div>

<script>

  // ============================================================
  // Mol* WORKSPACE + COMPARE (v12 shared workspace)
  // ============================================================

  let molWorkspaceWindow = null;
  let compareWindow = null;
  let compareSelection = [];
  let includeQueryInCompare = false;

  const compareSummaryEl = document.getElementById('compare-selection-summary');
  const compareButton = document.getElementById('compare-btn');
  const compareClearButton = document.getElementById('compare-clear-btn');
  const compareQueryCheckbox = document.getElementById('compare-query-checkbox');

  function compareKey(item) {
    return String(item?.accession || item || '').trim().toUpperCase();
  }

  function cleanCompareItem(item) {
    const accession = compareKey(item?.accession || item?.protein_id || item?.proteinId || item);
    if (!accession) return null;
    return {
      accession,
      proteinName: String(item?.proteinName || item?.protein_name || ''),
      organism: String(item?.organism || ''),
      tm: finiteNumber(item?.tm),
      aligned: finiteNumber(item?.aligned),
      identity: finiteNumber(item?.identity),
      shortLabel: String(item?.shortLabel || ''),
      tagSummary: String(item?.tagSummary || ''),
      source: String(item?.source || 'hit')
    };
  }

  function currentQueryItem() {
    const meta = currentProjectMeta || {};
    const panther = currentPantherEvidence || {};
    const pfam = currentPfamEvidence || {};

    const candidates = [
      meta.query_uniprot,
      meta.query_accession,
      meta.query_protein_id,
      meta.query_id,
      meta.uniprot_accession,
      meta.protein_id,
      panther.query_uniprot,
      panther.query_accession,
      panther.query_protein_id,
      pfam.query_uniprot,
      pfam.query_accession
    ];

    let accession = '';
    for (const candidate of candidates) {
      accession = compareKey(candidate);
      if (accession) break;
    }
    if (!accession) return null;

    return cleanCompareItem({
      accession,
      proteinName: meta.query_protein_name || meta.query_name || panther.query_name || pfam.query_name || accession,
      organism: meta.query_organism || meta.query_taxon_name || meta.organism || panther.query_organism || pfam.query_organism || '',
      source: 'query'
    });
  }

  function isCompareSelected(accession) {
    const key = compareKey(accession);
    return compareSelection.some(item => compareKey(item) === key);
  }

  function effectiveCompareItems() {
    const items = [];
    if (includeQueryInCompare) {
      const query = currentQueryItem();
      if (query) items.push(query);
    }
    for (const item of compareSelection) {
      if (items.length >= 2) break;
      items.push(item);
    }
    return items.slice(0, 2);
  }

  function compareRequirementText() {
    if (includeQueryInCompare) {
      return currentQueryItem() ? 'query + vyber 1 protein' : 'query protein není v projektu znám';
    }
    return 'vyber 2 proteiny';
  }

  function updateCompareUI() {
    if (!compareSummaryEl || !compareButton) return;

    const effective = effectiveCompareItems();
    if (effective.length === 0) {
      compareSummaryEl.innerHTML = '<span class="muted">' + escapeHtml(compareRequirementText()) + '</span>';
    } else {
      compareSummaryEl.innerHTML = effective.map((item, index) => {
        const prefix = item.source === 'query' ? 'Q.' : (index + 1) + '.';
        const title = [item.accession, item.proteinName, item.organism, item.tagSummary || item.shortLabel].filter(Boolean).join(' — ');
        return '<span class="compare-chip" title="' + escapeHtml(title) + '">' +
          prefix + ' ' + escapeHtml(item.accession) +
          (item.organism ? ' · ' + escapeHtml(item.organism) : '') +
          (item.source === 'query' ? ' · query' : '') +
          '</span>';
      }).join('');
    }

    if (compareQueryCheckbox) {
      const hasQuery = Boolean(currentQueryItem());
      compareQueryCheckbox.disabled = !hasQuery;
      compareQueryCheckbox.checked = includeQueryInCompare && hasQuery;
      compareQueryCheckbox.title = hasQuery
        ? 'Přidat query protein projektu jako pevnou referenci'
        : 'Viewer nezná query accession z project.json / evidence';
    }

    compareButton.disabled = effective.length !== 2;
    compareButton.title = includeQueryInCompare
      ? 'Porovná query protein s vybraným proteinem'
      : 'Superponuje dva vybrané proteiny v samostatném Mol* okně';

    document.querySelectorAll('.compare-hit-checkbox').forEach(box => {
      box.checked = isCompareSelected(box.dataset.proteinId);
    });
  }

  function toggleCompareItem(item, checked) {
    const normalized = cleanCompareItem(item);
    if (!normalized) return;

    const key = compareKey(normalized.accession);
    compareSelection = compareSelection.filter(x => compareKey(x) !== key);

    if (checked) {
      const maxItems = includeQueryInCompare ? 1 : 2;
      if (compareSelection.length >= maxItems) compareSelection.shift();
      compareSelection.push(normalized);
    }

    updateCompareUI();
  }

