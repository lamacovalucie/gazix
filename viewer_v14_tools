  function findOrganism(query) {
    const q = normalizeSearchText(query);
    if (!q) return null;

    const candidates = [...nodeIndex.values()].map(node => ({
      node,
      latin: normalizeSearchText(node?.name),
      czech: normalizeSearchText(node?.name_cs)
    }));

    return (
      candidates.find(x => x.latin === q || x.czech === q)
      || candidates.find(x => x.latin.startsWith(q) || x.czech.startsWith(q))
      || candidates.find(x => x.latin.includes(q) || x.czech.includes(q))
      || null
    )?.node || null;
  }

  function revealOrganism(node) {
    if (!node) return;

    searchedTaxid = node.taxid;
