  function annotationIdsForTaxon(taxid) {
    const raw = annotationStore.assignments?.[String(taxid)];
    return Array.isArray(raw) ? raw.filter(id => annotationStore.labels?.[id]) : [];
  }

  function annotationLabelsForTaxon(taxid) {
    return annotationIdsForTaxon(taxid)
      .map(id => ({ id, ...annotationStore.labels[id] }))
      .filter(Boolean);
  }

  function proteinEntryKey(hit, data) {
    const accession = compareKey(hit?.protein_id || hit?.proteinId || hit?.accession || '');
    if (!accession) return '';
    return String(data?.taxid ?? hit?.taxid ?? '0') + '::' + accession;
  }

  function proteinAnnotationIdsForEntry(hit, data) {
    const key = proteinEntryKey(hit, data);
    const raw = annotationStore.protein_assignments?.[key];
    return Array.isArray(raw)
      ? raw.filter(id => annotationStore.labels?.[id])
      : [];
  }

  function proteinAnnotationLabelsForEntry(hit, data) {
    return proteinAnnotationIdsForEntry(hit, data)
      .map(id => ({ id, ...annotationStore.labels[id] }))
      .filter(Boolean);
  }

  function proteinNoteForEntry(hit, data) {
    const key = proteinEntryKey(hit, data);
    const raw = annotationStore.protein_notes?.[key];
    return {
      short_label: String(raw?.short_label || ''),
      note: String(raw?.note || '')
    };
  }

  function proteinTagSummary(hit, data) {
    const note = proteinNoteForEntry(hit, data);
    const labels = proteinAnnotationLabelsForEntry(hit, data)
      .map(label => label.name || label.id)
      .filter(Boolean);
    const parts = [];
    if (note.short_label.trim()) parts.push(note.short_label.trim());
    if (labels.length) parts.push(labels.join(', '));
    return parts.join(' · ');
  }

  function proteinPassesAnnotationFilter(hit, data) {
    if (!proteinAnnotationFilterId) return true;
    return proteinAnnotationIdsForEntry(hit, data).includes(proteinAnnotationFilterId);
  }

  function toggleAnnotationForProtein(hit, data) {
    if (!data) return;
    if (!activeAnnotationId || !annotationStore.labels?.[activeAnnotationId]) {
      alert('Nejdřív nahoře vyber nebo vytvoř aktivní štítek.');
      return;
    }

    const key = proteinEntryKey(hit, data);
    if (!key) return;

    const current = new Set(proteinAnnotationIdsForEntry(hit, data));
    if (current.has(activeAnnotationId)) current.delete(activeAnnotationId);
    else current.add(activeAnnotationId);

    if (current.size > 0) annotationStore.protein_assignments[key] = [...current];
    else delete annotationStore.protein_assignments[key];

    saveAnnotations();
    if (selectedTaxid !== null && nodeIndex.has(selectedTaxid)) showInfo(nodeIndex.get(selectedTaxid));
  }

  function saveProteinNote(hit, data, shortLabel, note) {
    const key = proteinEntryKey(hit, data);
    if (!key) return;

    const shortText = String(shortLabel || '').trim();
    const noteText = String(note || '').trim();

    if (shortText || noteText) {
      annotationStore.protein_notes[key] = {
        short_label: shortText,
        note: noteText
      };
    } else {
      delete annotationStore.protein_notes[key];
    }

    saveAnnotations();
    if (selectedTaxid !== null && nodeIndex.has(selectedTaxid)) showInfo(nodeIndex.get(selectedTaxid));
  }

  function hitFromDataset(dataset) {
    return {
      protein_id: dataset.proteinId || '',
      protein_name: dataset.proteinName || '',
      tm_score: finiteNumber(dataset.tm),
      aligned_percent: finiteNumber(dataset.aligned),
      sequence_identity: finiteNumber(dataset.identity)
    };
  }

  function computeSubtreeAnnotations(node) {
    subtreeAnnotationLabels.clear();
    if (!node) return new Set();

    function walk(current) {
      const labels = new Set(annotationIdsForTaxon(current.taxid));
      for (const child of current.children || []) {
        for (const id of walk(child)) labels.add(id);
      }
      subtreeAnnotationLabels.set(current.taxid, labels);
      return labels;
    }

    return walk(node);
  }

  function subtreeHasAnnotation(data, annotationId) {
    if (!annotationId) return true;
    return Boolean(subtreeAnnotationLabels.get(data?.taxid)?.has(annotationId));
  }

  function toggleAnnotationForTaxon(data) {
    if (!data || !activeAnnotationId || !annotationStore.labels?.[activeAnnotationId]) return;

    const key = String(data.taxid);
    const current = new Set(annotationIdsForTaxon(data.taxid));

    if (current.has(activeAnnotationId)) {
      current.delete(activeAnnotationId);
    } else {
      current.add(activeAnnotationId);
    }

    if (current.size > 0) {
      annotationStore.assignments[key] = [...current];
    } else {
      delete annotationStore.assignments[key];
    }

    saveAnnotations();
    computeSubtreeAnnotations(originalData);
    render();
    showInfo(data);
  }

  function appendAnnotationMarkers(selection, dataAccessor) {
    selection.each(function(d) {
      const data = dataAccessor(d);
      const labels = annotationLabelsForTaxon(data?.taxid);
      if (!labels.length) return;

      const g = d3.select(this)
        .append("g")
        .attr("class", "annotation-markers")
        .attr("transform", "translate(-20,-20)");

      labels.slice(0, 6).forEach((label, index) => {
        const col = index % 3;
        const row = Math.floor(index / 3);

        g.append("circle")
          .attr("class", "annotation-marker")
          .attr("cx", col * 9)
          .attr("cy", row * 9)
          .attr("r", 4)
          .attr("fill", label.color || "#2f80ed");
      });

      if (labels.length > 6) {
        g.append("text")
          .attr("x", 27)
          .attr("y", 8)
          .attr("font-size", 8)
          .attr("fill", "#555")
          .text(`+${labels.length - 6}`);
      }
    });
  }

  function annotationSection(data) {
    const labels = annotationLabelsForTaxon(data?.taxid);
    if (!labels.length) return "";

    const chips = labels.map(label => `
      <span class="annotation-chip">
        <span class="annotation-chip-dot" style="background:${escapeHtml(label.color || "#2f80ed")}"></span>
        ${escapeHtml(label.name || label.id)}
      </span>
    `).join("");

    return `
      <div class="info-row">
        <div class="info-label">Uživatelské štítky</div>
        <div class="annotation-summary">${chips}</div>
      </div>
    `;
  }

  function pantherEvidenceForNode(data) {
    if (!data) return null;
    return pantherByTaxid.get(Number(data.taxid)) || null;
  }

  function pfamEvidenceForNode(data) {
    if (!data) return null;
    return pfamByTaxid.get(Number(data.taxid)) || null;
  }

  function hasPfamFamilyDirect(data) {
    const evidence = pfamEvidenceForNode(data);
    return Boolean(evidence?.family_member);
  }

  function hasDirectAlphaFind(data) {
    return Boolean(
      data &&
      Number(directFilteredHitCount.get(data.taxid) || 0) > 0
    );
  }

  function hasPantherFamilyDirect(data) {
    const evidence = pantherEvidenceForNode(data);
    return Boolean(evidence?.family_member);
  }

  function hasQuerySubfamilyDirect(data) {
    const evidence = pantherEvidenceForNode(data);
    return Boolean(evidence?.same_query_subfamily);
  }

  function evidenceClassForNode(data) {
    const alpha = hasDirectAlphaFind(data);
    const pantherFamily = hasPantherFamilyDirect(data);
    const querySubfamily = hasQuerySubfamilyDirect(data);

    if (alpha && pantherFamily) return "both";
    if (querySubfamily) return "panther-subfamily";
    if (pantherFamily) return "panther-family";
    return null;
  }

  function computeSubtreePanther(node) {
    let hasPanther = hasPantherFamilyDirect(node);
    let hasQuerySubfamily = hasQuerySubfamilyDirect(node);

    for (const child of node.children || []) {
      const childResult = computeSubtreePanther(child);
      hasPanther = hasPanther || childResult.hasPanther;
      hasQuerySubfamily =
        hasQuerySubfamily || childResult.hasQuerySubfamily;
    }

    subtreeHasPanther.set(node.taxid, hasPanther);
    subtreeHasQuerySubfamily.set(node.taxid, hasQuerySubfamily);

    return { hasPanther, hasQuerySubfamily };
  }

  function computeSubtreePfam(node) {
    let hasPfam = hasPfamFamilyDirect(node);

    for (const child of node.children || []) {
      hasPfam = computeSubtreePfam(child) || hasPfam;
    }

    subtreeHasPfam.set(node.taxid, hasPfam);
    return hasPfam;
  }

  function computeSubtreeAlphaOutsidePfam(node) {
    let hasAlphaOutsidePfam =
      Number(directFilteredHitCount.get(node.taxid) || 0) > 0
      && !hasPfamFamilyDirect(node);

    for (const child of node.children || []) {
      hasAlphaOutsidePfam =
        computeSubtreeAlphaOutsidePfam(child) || hasAlphaOutsidePfam;
    }

    subtreeHasAlphaOutsidePfam.set(node.taxid, hasAlphaOutsidePfam);
    return hasAlphaOutsidePfam;
  }

  function computeSubtreeAlphaOnly(node) {
    // Přímý AlphaFind-only taxon = po aktuálním score filtru má alespoň
    // jeden AlphaFind hit, ale nemá přímou PANTHER family evidence.
    let hasAlphaOnly =
      Number(directFilteredHitCount.get(node.taxid) || 0) > 0
      && !hasPantherFamilyDirect(node);

    for (const child of node.children || []) {
      hasAlphaOnly =
        computeSubtreeAlphaOnly(child) || hasAlphaOnly;
    }

    subtreeHasAlphaOnly.set(node.taxid, hasAlphaOnly);
    return hasAlphaOnly;
  }

  function nodeHasAnyEvidence(data) {
    return Boolean(
      nodeHasHit(data) ||
      subtreeHasPanther.get(data.taxid) ||
      subtreeHasPfam.get(data.taxid)
    );
  }

  function pfamSection(data) {
    const evidence = pfamEvidenceForNode(data);
    if (!evidence) return "";

    const accessions = Array.isArray(evidence.uniprot_accessions)
      ? evidence.uniprot_accessions
      : [];

    const shown = accessions.slice(0, 30);
    const accessionsHtml = shown.length
      ? shown.map(escapeHtml).join(", ")
      : "—";
    const more = accessions.length > shown.length
      ? ` … +${accessions.length - shown.length}`
      : "";

    return `
      <div class="info-row">
        <div class="info-label">Pfam evidence</div>
        <div class="info-value">
          <strong>${escapeHtml(evidence.pfam_id || currentPfamEvidence?.pfam_id || "Pfam")}</strong>
          ${evidence.pfam_name ? ` — ${escapeHtml(evidence.pfam_name)}` : ""}
        </div>
        <div class="score-grid">
          <div>Pfam members v taxonu</div>
          <div><strong>${Number(evidence.family_member_count || 0)}</strong></div>
        </div>
        <div class="muted" style="margin-top:8px;font-size:12px;">
          UniProt: ${accessionsHtml}${more}
        </div>
      </div>
    `;
  }

  function pantherSection(data) {
    const evidence = pantherEvidenceForNode(data);
    if (!evidence) return "";

    const accessions =
      Array.isArray(evidence.uniprot_accessions)
        ? evidence.uniprot_accessions
        : [];

    const shown = accessions.slice(0, 10);
    const accessionsHtml =
      shown.length
        ? shown.map(escapeHtml).join(", ")
        : "—";

    const more =
      accessions.length > shown.length
        ? ` … +${accessions.length - shown.length}`
        : "";

    const subfamilies =
      Array.isArray(evidence.subfamily_ids)
        ? evidence.subfamily_ids
        : [];

    const relation =
      evidence.same_query_subfamily
        ? "stejná subfamily jako query"
        : "člen stejné PANTHER family";

    return `
      <div class="info-row">
        <div class="info-label">PANTHER evidence</div>
        <div class="info-value">
          <strong>${escapeHtml(relation)}</strong>
        </div>

        <div class="score-grid">
          <div>Family members v taxonu</div>
          <div><strong>${Number(evidence.family_member_count || 0)}</strong></div>

          <div>Query-subfamily members</div>
          <div><strong>${Number(evidence.query_subfamily_member_count || 0)}</strong></div>

          <div>Subfamilies</div>
          <div>${escapeHtml(subfamilies.join(", ") || "—")}</div>
        </div>

        <div class="muted" style="margin-top:8px;font-size:12px;">
          UniProt: ${accessionsHtml}${more}
        </div>
      </div>
    `;
  }

  function nodeFill(data) {
    return scoreColor(bestScoreForNode(data));
  }

  function escapeHtml(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function formatNumber(value, digits = 3) {
    if (
      value === null ||
      value === undefined ||
      Number.isNaN(Number(value))
    ) {
      return "—";
    }

    return Number(value)
      .toFixed(digits)
      .replace(/\.?0+$/, "");
  }

  function displayName(data) {
    const latin =
      data?.name || `Tax ID ${data?.taxid ?? "?"}`;

    const czech =
      data?.name_cs ? String(data.name_cs).trim() : "";

    if (
      labelMode === "cs-latin" &&
      czech &&
      czech.toLocaleLowerCase("cs") !== latin.toLocaleLowerCase("cs")
    ) {
      return `${czech} (${latin})`;
    }

    if (labelMode === "cs-latin" && czech) {
      return czech;
    }

    return latin;
  }

  function nodeClass(data) {
    return data.node_type || "context";
  }

  function nodeHasHit(data) {
    return Boolean(
      data &&
      Number(subtreeFilteredHitCount.get(data.taxid) || 0) > 0
    );
  }


  function mergeSearchVisible(children, filteredChildren) {
    if (searchRevealTaxids.size === 0) return filteredChildren;
    const forced = children.filter(child => searchRevealTaxids.has(child.taxid));
    return [...new Map([...filteredChildren, ...forced].map(x => [x.taxid, x])).values()];
  }

  function visibleChildren(data) {
    const children = data.children || [];

    // Vyhledanou cestu vždy ponecháme viditelnou, i když by ji
    // aktuální evidence/štítkový filtr jinak skryl.
    const searchChildren = children.filter(child =>
      searchRevealTaxids.has(child.taxid)
    );

    if (annotationFilterId) {
      const annotated = children.filter(child =>
        subtreeHasAnnotation(child, annotationFilterId)
      );
      return [...new Map([...annotated, ...searchChildren].map(x => [x.taxid, x])).values()];
    }

    if (viewFilter === "context") {
      return children;
    }

    if (viewFilter === "panther") {
      // Zobraz jen větve, ve kterých je alespoň jeden přímý člen
      // zvolené PANTHER family. Nadřazené taxony zůstávají jako cesta.
      return mergeSearchVisible(children, children.filter(child =>
        Boolean(subtreeHasPanther.get(child.taxid))
      ));
    }

    if (viewFilter === "pfam") {
      return mergeSearchVisible(children, children.filter(child =>
        Boolean(subtreeHasPfam.get(child.taxid))
      ));
    }

    if (viewFilter === "alpha-only") {
      // Zobraz jen větve vedoucí k taxonům, které mají AlphaFind hit
      // po aktuálním score filtru, ale nemají přímou PANTHER family evidence.
      return mergeSearchVisible(children, children.filter(child =>
        Boolean(subtreeHasAlphaOnly.get(child.taxid))
      ));
    }

    if (viewFilter === "alpha-outside-pfam") {
      return mergeSearchVisible(children, children.filter(child =>
        Boolean(subtreeHasAlphaOutsidePfam.get(child.taxid))
      ));
    }

    return mergeSearchVisible(children, children.filter(nodeHasAnyEvidence));
  }

  function promoteThroughUnaryNoRank(node) {
    let current = node;
    const visited = new Set();

    while (
      current &&
      current.rank === "no rank" &&
      !(Number(directFilteredHitCount.get(current.taxid) || 0) > 0) &&
      !visited.has(current.taxid)
    ) {
      visited.add(current.taxid);

      const children = visibleChildren(current);

      if (children.length !== 1) {
        break;
      }

      current = children[0];
    }

    return current;
  }

  function overviewChildren(data) {
    const result = [];
    const seen = new Set();

    for (const child of visibleChildren(data)) {
      const promoted = promoteThroughUnaryNoRank(child);

      if (promoted && !seen.has(promoted.taxid)) {
        seen.add(promoted.taxid);
        result.push(promoted);
      }
    }

    return result;
  }

  function hasExpandableChildren(data) {
    return overviewChildren(data).length > 0;
  }

  function nodeRadius(data) {
    if (data.node_type === "hit") {
      return 9;
    }

    if (hasExpandableChildren(data)) {
      return 8;
    }

    return 6;
  }

  function subtreeScoreSection(data) {
    const best = bestScoreForNode(data);

    if (best === null || Number.isNaN(best)) return "";

    const config = METRIC_CONFIG[colorMetric] || METRIC_CONFIG.tm;
    const digits = colorMetric === "tm" ? 3 : 1;
    const unit = colorMetric === "tm" ? "" : " %";

    return `
      <div class="info-row">
        <div class="info-label">Nejlepší ${escapeHtml(config.label)} ve větvi</div>
        <div class="info-value">
          <strong>${formatNumber(best, digits)}${unit}</strong>
        </div>
      </div>
    `;
  }

  function scoreSection(data) {
    const hits = directHits(data);
    if (hits.length === 0) return "";

    const bestOf = metric => {
      let best = null;
      for (const hit of hits) {
        const value = hitMetricValue(hit, metric);
        if (value !== null && (best === null || value > best)) best = value;
      }
      return best;
    };

    const tmBest = bestOf("tm");
    const alignedBest = bestOf("aligned");
    const identityBest = bestOf("identity");
    const passed = filteredHitsForNode(data).length;

    return `
      <div class="info-row">
        <div class="info-label">Kvalita AlphaFind hitů</div>

        <div class="score-grid">
          <div>TM-score max</div>
          <div><strong>${formatNumber(tmBest)}</strong></div>

          <div>Aligned residues max</div>
          <div><strong>${formatNumber(alignedBest, 1)} %</strong></div>

          <div>Sequence identity max</div>
          <div><strong>${formatNumber(identityBest, 1)} %</strong></div>

          <div>Hity po filtru</div>
          <div><strong>${passed}/${hits.length}</strong></div>
        </div>
      </div>
    `;
  }

  function hitsSection(data) {
    const allHits = directHits(data);
    const hits = filteredHitsForNode(data);

    if (allHits.length === 0) return "";

    const labelEntries = Object.entries(annotationStore.labels || {})
      .sort((a, b) => String(a[1]?.name || '').localeCompare(String(b[1]?.name || ''), 'cs'));

    const proteinFilterOptions = [
      '<option value="">bez filtru</option>',
      ...labelEntries.map(([id, label]) =>
        `<option value="${escapeHtml(id)}" ${id === proteinAnnotationFilterId ? 'selected' : ''}>${escapeHtml(label.name || id)}</option>`
      )
    ].join('');

    if (hits.length === 0) {
      return `
        <div class="info-row">
          <div class="info-label">Jednotlivé hity</div>
          <div class="protein-filter-row">
            <label for="protein-annotation-filter">Filtrovat proteinovým štítkem:</label>
            <select id="protein-annotation-filter">${proteinFilterOptions}</select>
          </div>
          <p class="muted">Žádný AlphaFind hit v tomto taxonu nesplňuje aktuální score filtr.</p>
        </div>
      `;
    }

    const sortedHits = [...hits].sort((a, b) => {
      const bv = hitMetricValue(b, colorMetric);
      const av = hitMetricValue(a, colorMetric);
      return (bv ?? -Infinity) - (av ?? -Infinity);
    });

    const shown = sortedHits.filter(hit => proteinPassesAnnotationFilter(hit, data));

    const items = shown.map(hit => {
      const tm = hitMetricValue(hit, 'tm');
      const aligned = hitMetricValue(hit, 'aligned');
      const identity = hitMetricValue(hit, 'identity');
      const accession = hit.protein_id || '';
      const note = proteinNoteForEntry(hit, data);
      const labels = proteinAnnotationLabelsForEntry(hit, data);
      const tagSummary = proteinTagSummary(hit, data);
      const chips = labels.length
        ? `<div class="annotation-summary protein-chips">${labels.map(label => `
            <span class="annotation-chip">
              <span class="annotation-chip-dot" style="background:${escapeHtml(label.color || '#2f80ed')}"></span>
              ${escapeHtml(label.name || label.id)}
            </span>`).join('')}</div>`
        : '';
      const activeLabelName = activeAnnotationId && annotationStore.labels?.[activeAnnotationId]
        ? annotationStore.labels[activeAnnotationId].name || activeAnnotationId
        : '';
      const uniprotUrl = accession
        ? `https://www.uniprot.org/uniprotkb/${encodeURIComponent(accession)}`
        : '#';

      return `
      <li class="protein-hit">
        <div>
          <strong
            class="protein-id-draggable"
            draggable="true"
            data-protein-id="${escapeHtml(accession)}"
            data-protein-name="${escapeHtml(hit.protein_name || '')}"
            data-organism="${escapeHtml(data.name || '')}"
            data-tm="${tm ?? ''}"
            data-aligned="${aligned ?? ''}"
            data-identity="${identity ?? ''}"
            data-short-label="${escapeHtml(note.short_label || '')}"
            data-tag-summary="${escapeHtml(tagSummary)}"
            title="Přetáhni do Mol* workspace"
          >${escapeHtml(accession || 'bez ID')}</strong>
          <label class="compare-hit-label" title="Vybrat tento protein pro Compare">
            <input
              type="checkbox"
              class="compare-hit-checkbox"
              data-protein-id="${escapeHtml(accession)}"
              data-protein-name="${escapeHtml(hit.protein_name || '')}"
              data-organism="${escapeHtml(data.name || '')}"
              data-tm="${tm ?? ''}"
              data-aligned="${aligned ?? ''}"
              data-identity="${identity ?? ''}"
              data-short-label="${escapeHtml(note.short_label || '')}"
              data-tag-summary="${escapeHtml(tagSummary)}"
              ${isCompareSelected(accession) ? 'checked' : ''}
            /> compare
          </label>
        </div>
        <div class="protein-meta">
          TM ${formatNumber(tm)}, aligned ${formatNumber(aligned, 1)} %, sequence identity ${formatNumber(identity, 1)} %
          ${hit.protein_name ? `<br><span class="muted">${escapeHtml(hit.protein_name)}</span>` : ''}
          ${tagSummary ? `<br><span class="muted"><strong>Ruční štítek:</strong> ${escapeHtml(tagSummary)}</span>` : ''}
        </div>
        <div class="protein-tools-row">
          <input
            type="text"
            class="protein-short-label-input"
            data-protein-id="${escapeHtml(accession)}"
            data-protein-name="${escapeHtml(hit.protein_name || '')}"
            data-tm="${tm ?? ''}"
            data-aligned="${aligned ?? ''}"
            data-identity="${identity ?? ''}"
            placeholder="Krátký popisek / vlastní štítek"
            value="${escapeHtml(note.short_label || '')}"
          />
          <button
            type="button"
            class="protein-tag-btn"
            data-protein-id="${escapeHtml(accession)}"
            data-protein-name="${escapeHtml(hit.protein_name || '')}"
            data-tm="${tm ?? ''}"
            data-aligned="${aligned ?? ''}"
            data-identity="${identity ?? ''}"
            ${activeLabelName ? '' : 'disabled'}
            title="${activeLabelName ? `Přidat/odebrat aktivní štítek: ${escapeHtml(activeLabelName)}` : 'Nejdřív nahoře vyber nebo vytvoř aktivní štítek'}"
          >🏷 ${activeLabelName ? `aktivní štítek: ${escapeHtml(activeLabelName)}` : 'aktivní štítek'}</button>
          <a class="protein-link-btn" href="${uniprotUrl}" target="_blank" rel="noopener noreferrer">UniProt ↗</a>
        </div>
        ${chips}
        <details class="protein-note-details">
          <summary>Delší poznámka${note.note.trim() ? ' · uloženo' : ''}</summary>
          <textarea
            class="protein-long-note-textarea"
            data-protein-id="${escapeHtml(accession)}"
            data-protein-name="${escapeHtml(hit.protein_name || '')}"
            data-tm="${tm ?? ''}"
            data-aligned="${aligned ?? ''}"
            data-identity="${identity ?? ''}"
            placeholder="Sem si můžeš psát delší poznámky k tomuto konkrétnímu proteinu…"
          >${escapeHtml(note.note || '')}</textarea>
          <div class="protein-actions">
            <button type="button" class="protein-note-save-btn" data-protein-id="${escapeHtml(accession)}" data-protein-name="${escapeHtml(hit.protein_name || '')}" data-tm="${tm ?? ''}" data-aligned="${aligned ?? ''}" data-identity="${identity ?? ''}">Uložit poznámku</button>
            <button type="button" class="protein-note-clear-btn" data-protein-id="${escapeHtml(accession)}" data-protein-name="${escapeHtml(hit.protein_name || '')}" data-tm="${tm ?? ''}" data-aligned="${aligned ?? ''}" data-identity="${identity ?? ''}">Smazat</button>
            <span class="protein-note-status"></span>
          </div>
        </details>
      </li>
      `;
    }).join('');

    const filterNote = scoreFilterEnabled
      ? `<p class="muted" style="font-size:12px;">Filtr: ${escapeHtml(METRIC_CONFIG[scoreFilterMetric].label)} ≥ ${formatNumber(scoreFilterThreshold, scoreFilterMetric === 'tm' ? 2 : 1)}${scoreFilterMetric === 'tm' ? '' : ' %'} · zobrazeno ${hits.length}/${allHits.length}</p>`
      : '';

    const proteinTagFilterNote = proteinAnnotationFilterId && shown.length === 0
      ? `<p class="muted" style="font-size:12px;">Po proteinovém štítku se v tomto taxonu nic nenašlo.</p>`
      : '';

    return `
      <div class="info-row">
        <div class="info-label">Jednotlivé hity</div>
        <div class="protein-filter-row">
          <label for="protein-annotation-filter">Filtrovat proteinovým štítkem:</label>
          <select id="protein-annotation-filter">${proteinFilterOptions}</select>
        </div>
        ${filterNote}
        ${proteinTagFilterNote}
        <ol class="hits-list">${items}</ol>
        <div class="mol-hint">🧬 UniProt ID můžeš přetáhnout do otevřeného Mol* workspace. Přes „aktivní štítek“ můžeš ke konkrétním proteinům přiřazovat stejné štítky, které už používáš u taxonů.</div>
      </div>
    `;
  }

  function wireProteinControls(data) {
    const filterSelect = document.getElementById('protein-annotation-filter');
    if (filterSelect) {
      filterSelect.addEventListener('change', () => {
        proteinAnnotationFilterId = filterSelect.value || '';
        showInfo(data);
      });
    }

    document.querySelectorAll('.protein-tag-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        toggleAnnotationForProtein(hitFromDataset(btn.dataset), data);
      });
    });

    document.querySelectorAll('.protein-note-save-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const row = btn.closest('.protein-hit');
        if (!row) return;
        const shortInput = row.querySelector('.protein-short-label-input');
        const longTextarea = row.querySelector('.protein-long-note-textarea');
        const status = row.querySelector('.protein-note-status');
        saveProteinNote(
          hitFromDataset(btn.dataset),
          data,
          shortInput ? shortInput.value : '',
          longTextarea ? longTextarea.value : ''
        );
        if (status) {
          status.textContent = 'Uloženo';
          setTimeout(() => {
            if (status) status.textContent = '';
          }, 1500);
        }
      });
    });

    document.querySelectorAll('.protein-note-clear-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const row = btn.closest('.protein-hit');
        if (!row) return;
        const shortInput = row.querySelector('.protein-short-label-input');
        const longTextarea = row.querySelector('.protein-long-note-textarea');
        const status = row.querySelector('.protein-note-status');
        if (shortInput) shortInput.value = '';
        if (longTextarea) longTextarea.value = '';
        saveProteinNote(hitFromDataset(btn.dataset), data, '', '');
        if (status) {
          status.textContent = 'Smazáno';
          setTimeout(() => {
            if (status) status.textContent = '';
          }, 1500);
        }
      });
    });
  }

  function showInfo(
    data,
    anchorClientY = null
  ) {
    selectedTaxid = data.taxid;

    /*
      Detail se nemusí zobrazovat vždy úplně nahoře.

      Pokud víme, kde uživatel klikl, posuneme začátek
      informačního bloku přibližně do stejné výšky
      v pravém panelu. Strom samotný se nijak neposouvá.

      Je to stabilnější než odhadovat pozici podle počtu
      rozbalených taxonů, protože funguje i po ručním
      scrollování/panování stromu.
    */
    if (
      sidePanel
      && infoEl
      && anchorClientY !== null
    ) {
      const sideRect =
        sidePanel.getBoundingClientRect();

      const desiredOffset =
        anchorClientY
        - sideRect.top
        - 35;

      const maxOffset =
        Math.max(
          0,
          Math.min(
            360,
            sideRect.height * 0.55
          )
        );

      const offset =
        Math.max(
          0,
          Math.min(
            desiredOffset,
            maxOffset
          )
        );

      sidePanel.scrollTop = 0;
      infoEl.style.marginTop =
        `${offset}px`;
    }

    else if (
      infoEl
      && anchorClientY === null
    ) {
      /*
        Při otevření detailu tlačítkem apod. necháme
        informační blok nahoře.
      */
      infoEl.style.marginTop =
        "0px";
    }

    const czech =
      data.name_cs ? escapeHtml(data.name_cs) : "—";

    const canDrill = visibleChildren(data).length > 0;

    document.getElementById("info").innerHTML = `
      <div class="info-row">
        <div class="info-label">Název</div>
        <div class="info-value"><strong>${escapeHtml(displayName(data))}</strong></div>
      </div>

      <div class="info-row">
        <div class="info-label">Scientific name</div>
        <div class="info-value">${escapeHtml(data.name)}</div>
      </div>

      <div class="info-row">
        <div class="info-label">Český název</div>
        <div class="info-value">${czech}</div>
      </div>

      <div class="info-row">
        <div class="info-label">Rank</div>
        <div class="info-value">${escapeHtml(data.rank)}</div>
      </div>

      <div class="info-row">
        <div class="info-label">NCBI Tax ID</div>
        <div class="info-value">${data.taxid}</div>
      </div>

      <div class="info-row">
        <div class="info-label">Direct AlphaFind hits</div>
        <div class="info-value">${Number(directFilteredHitCount.get(data.taxid) || 0)} / ${Number(data.direct_hit_count || directHits(data).length || 0)}</div>
      </div>

      <div class="info-row">
        <div class="info-label">Hits in subtree</div>
        <div class="info-value">${Number(subtreeFilteredHitCount.get(data.taxid) || 0)}</div>
      </div>

      ${subtreeScoreSection(data)}
      ${scoreSection(data)}
      ${hitsSection(data)}
      ${annotationSection(data)}
      ${pantherSection(data)}
      ${pfamSection(data)}
      ${taxonNotesSection(data)}

      ${
        canDrill
          ? `
            <button
              id="open-drill-btn"
              class="side-action"
              type="button"
            >
              Otevřít detailní drill-down
            </button>
          `
          : ""
      }
    `;

    
    wireTaxonNoteControls(data);
    wireProteinControls(data);

    const drillButton =
      document.getElementById("open-drill-btn");

    if (drillButton) {
      drillButton.addEventListener("click", () => {
        currentTaxid = data.taxid;
        mode = "drill";
        render();
        resetScrollToTopLeft();
      });
    }
  }

  function getTaxonPath(taxid) {
    const path = [];
    let current = taxid;

    while (current !== undefined && current !== null) {
      const node = nodeIndex.get(current);
      if (!node) break;

      path.unshift(node);
      current = parentIndex.get(current);
    }

    return path;
  }

  function updateBreadcrumb() {
    breadcrumbEl.innerHTML = "";

    if (mode === "explore") {
      breadcrumbEl.textContent = "Celkový rozbalovací přehled";
      backButton.disabled = true;
      return;
    }

    backButton.disabled = !parentIndex.has(currentTaxid);

    const path = getTaxonPath(currentTaxid);

    path.forEach((node, index) => {
      const span = document.createElement("span");
      span.textContent = displayName(node);
      span.className = "breadcrumb-item";

      span.addEventListener("click", () => {
        currentTaxid = node.taxid;
        mode = "drill";
        render();
        resetScrollToTopLeft();
      });

      breadcrumbEl.appendChild(span);

      if (index < path.length - 1) {
        breadcrumbEl.append("  ›  ");
      }
    });
  }

  // ============================================================
  // EXPLORE VIEW — STROM SHORA DOLŮ
  // ============================================================

  function buildExploreData(data, isRoot = false) {
    const copy = { ...data };
    const children = overviewChildren(data);

    // Hlavní "kmen" s jedinou relevantní větví se ukazuje automaticky.
    const shouldExpand =
      isRoot ||
      expandedTaxids.has(data.taxid) ||
      children.length === 1;

    if (shouldExpand && children.length > 0) {
      copy.children = children.map(child =>
        buildExploreData(child, false)
      );
    } else {
      delete copy.children;
    }

    return copy;
  }

  function renderExplore() {
    svg.selectAll("*").remove();

    const exploreData =
      buildExploreData(originalData, true);

    const hierarchy =
      d3.hierarchy(exploreData);

    /*
      nodeSize:
      první číslo = horizontální mezera mezi sousedními větvemi
      druhé číslo = vertikální vzdálenost jednotlivých pater

      240 px na šířku dává dost prostoru i delším českým názvům.
    */
    const treeLayout =
      d3.tree()
        .nodeSize([240, 82]);

    treeLayout(hierarchy);

    const descendants =
      hierarchy.descendants();

    const minX =
      d3.min(descendants, d => d.x) ?? 0;

    const maxX =
      d3.max(descendants, d => d.x) ?? 0;

    const maxY =
      d3.max(descendants, d => d.y) ?? 0;

    const margin = {
      top: 55,
      right: 180,
      bottom: 140,
      left: 180
    };

    const width =
      Math.max(
        treeWrap.clientWidth,
        (maxX - minX) + margin.left + margin.right
      );

    const height =
      Math.max(
        treeWrap.clientHeight,
        maxY + margin.top + margin.bottom
      );

    svg
      .attr("width", width)
      .attr("height", height)
      .attr(
        "viewBox",
        `0 0 ${width} ${height}`
      );

    /*
      x z D3 stromu používáme jako horizontální souřadnici,
      y jako vertikální hloubku.

      Posun -minX zajistí, že nic neuteče vlevo mimo plátno.
    */
    const group =
      svg.append("g")
        .attr(
          "transform",
          `translate(${margin.left - minX},${margin.top})`
        );

    const linkGenerator =
      d3.linkVertical()
        .x(d => d.x)
        .y(d => d.y);

    group
      .append("g")
      .selectAll("path")
      .data(hierarchy.links())
      .join("path")
      .attr(
        "class",
        d =>
          `link ${nodeClass(d.target.data)}`
      )
      .attr(
        "d",
        linkGenerator
      );

    const nodes =
      group
        .append("g")
        .selectAll("g")
        .data(descendants)
        .join("g")
        .attr(
          "class",
          d => {
            const realData =
              nodeIndex.get(d.data.taxid)
              || d.data;

            const expandable =
              hasExpandableChildren(realData)
                ? " expandable"
                : "";

            return (
              `node ${nodeClass(realData)}${expandable}`
            );
          }
        )
        .attr(
          "transform",
          d =>
            `translate(${d.x},${d.y})`
        )
        .attr("data-taxid", d => String(d.data.taxid))
        .style(
          "cursor",
          d => {
            const realData =
              nodeIndex.get(d.data.taxid)
              || d.data;

            return hasExpandableChildren(realData)
              ? "pointer"
              : "default";
          }
        )
        .on(
          "click",
          (event, d) => {
            event.stopPropagation();

            const realData =
              nodeIndex.get(d.data.taxid)
              || d.data;

            showInfo(
              realData,
              event.clientY
            );

            if (annotationMode && activeAnnotationId) {
              toggleAnnotationForTaxon(realData);
              return;
            }

            if (!hasExpandableChildren(realData)) {
              return;
            }

            if (
              expandedTaxids.has(realData.taxid)
            ) {
              expandedTaxids.delete(
                realData.taxid
              );
            } else {
              expandedTaxids.add(
                realData.taxid
              );
            }

            render();
          }
        );

    /*
      Velká neviditelná klikací oblast.
    */
    /*
      Neviditelná klikací oblast zůstává o něco větší než grafický uzel.
    */
    nodes
      .append("circle")
      .attr(
        "class",
        "node-hitbox"
      )
      .attr(
        "r",
        23
      );

    nodes
      .filter(d => Number(d.data.taxid) === Number(searchedTaxid))
      .append("circle")
      .attr("class", "search-highlight")
      .attr("r", 27);

    appendAnnotationMarkers(nodes, d =>
      nodeIndex.get(d.data.taxid) || d.data
    );

    /*
      PANTHER evidence = obrys kolem TM-score disku.
      Obrys se kreslí jen tam, kde má taxon přímou PANTHER evidence.
    */
    nodes
      .filter(d => {
        const realData =
          nodeIndex.get(d.data.taxid) || d.data;
        return Boolean(evidenceClassForNode(realData));
      })
      .append("circle")
      .attr(
        "class",
        d => {
          const realData =
            nodeIndex.get(d.data.taxid) || d.data;
          return `evidence-ring ${evidenceClassForNode(realData)}`;
        }
      )
      .attr("r", 23);

    nodes
      .filter(d => {
        const realData = nodeIndex.get(d.data.taxid) || d.data;
        return hasPfamFamilyDirect(realData);
      })
      .append("rect")
      .attr("class", "pfam-marker")
      .attr("x", 15)
      .attr("y", -22)
      .attr("width", 12)
      .attr("height", 12)
      .attr("rx", 2);

    /*
      TM-score teď barví VELKÝ VNĚJŠÍ DISK.
      Takže barevná informace nezapadne v malém středu.
    */
    nodes
      .append("circle")
      .attr(
        "class",
        "score-ring"
      )
      .attr(
        "r",
        18
      )
      .style(
        "fill",
        d => {
          const realData =
            nodeIndex.get(d.data.taxid)
            || d.data;

          return nodeFill(realData);
        }
      );

    /*
      Vnitřní disk je vždy tmavý.
      U rozbalitelných uzlů v něm sedí bílé + / −.
    */
    nodes
      .append("circle")
      .attr(
        "class",
        "visible-circle"
      )
      .attr(
        "r",
        d => {
          const realData =
            nodeIndex.get(d.data.taxid)
            || d.data;

          return hasExpandableChildren(realData) ? 10 : 8;
        }
      );

    nodes
      .filter(
        d => {
          const realData =
            nodeIndex.get(d.data.taxid)
            || d.data;

          return hasExpandableChildren(realData);
        }
      )
      .append("text")
      .attr(
        "class",
        "expand-mark"
      )
      .attr("x", 0)
      .attr("y", 1)
      .text(
        d => {
          const realData =
            nodeIndex.get(d.data.taxid)
            || d.data;

          const children =
            overviewChildren(realData);

          const autoExpanded =
            children.length === 1;

          const manuallyExpanded =
            expandedTaxids.has(
              realData.taxid
            );

          return (
            autoExpanded || manuallyExpanded
              ? "−"
              : "+"
          );
        }
      );

    /*
      Název zůstává vždy horizontální.
      Je pod uzlem, takže dlouhé názvy nepřekážejí
      čarám tolik jako v radiálním stromu.
    */
    nodes
      .append("text")
      .attr("x", 0)
      .attr("y", 24)
      .attr(
        "text-anchor",
        "middle"
      )
      .text(
        d => {
          const realData =
            nodeIndex.get(d.data.taxid)
            || d.data;

          const base =
            displayName(realData);

          if (
            Number(directFilteredHitCount.get(realData.taxid) || 0) > 0
          ) {
            return (
              `${base} (${Number(directFilteredHitCount.get(realData.taxid) || 0)})`
            );
          }

          return base;
        }
      );

    const visibleCount =
      descendants.length;

    const filterText =
      annotationFilterId
        ? `štítek: ${annotationStore.labels?.[annotationFilterId]?.name || annotationFilterId}`
        : viewFilter === "hits"
          ? "jen větve s evidence"
          : viewFilter === "panther"
            ? "jen větve s PANTHER family"
            : viewFilter === "pfam"
              ? "jen větve s Pfam family"
              : viewFilter === "alpha-only"
                ? "jen AlphaFind hity mimo PANTHER family"
                : viewFilter === "alpha-outside-pfam"
                  ? "jen AlphaFind hity mimo Pfam family"
                  : "evidence + kontext";

    const scoreFilterText = scoreFilterEnabled
      ? ` · AlphaFind filtr: ${METRIC_CONFIG[scoreFilterMetric].label} ≥ ${formatNumber(scoreFilterThreshold, scoreFilterMetric === "tm" ? 2 : 1)}${scoreFilterMetric === "tm" ? "" : " %"}`
      : "";

    statusEl.textContent =
      `Viditelné uzly: ${visibleCount} · ${filterText}${scoreFilterText}`;
  }

  // ============================================================
  // DRILL-DOWN VIEW
  // ============================================================

  function renderDrilldown() {
    svg.selectAll("*").remove();

    const current =
      nodeIndex.get(currentTaxid);

    if (!current) return;

    const children =
      [...visibleChildren(current)]
        .sort(
          (a, b) =>
            displayName(a)
              .localeCompare(
                displayName(b),
                "cs"
              )
        );

    const columnWidth = 240;
    const topY = 90;
    const childY = 230;

    const width =
      Math.max(
        treeWrap.clientWidth,
        360 + Math.max(1, children.length) * columnWidth
      );

    const height =
      Math.max(
        treeWrap.clientHeight,
        520
      );

    svg
      .attr("width", width)
      .attr("height", height)
      .attr(
        "viewBox",
        `0 0 ${width} ${height}`
      );

    const group =
      svg.append("g");

    const centerX =
      width / 2;

    const centerGroup =
      group
        .append("g")
        .attr(
          "class",
          `node center-node ${nodeClass(current)}`
        )
        .attr(
          "transform",
          `translate(${centerX},${topY})`
        )
        .attr("data-taxid", String(current.taxid))
        .on(
          "click",
          event => {
            showInfo(current, event.clientY);
            if (annotationMode && activeAnnotationId) {
              toggleAnnotationForTaxon(current);
            }
          }
        );


    if (Number(current.taxid) === Number(searchedTaxid)) {
      centerGroup
        .append("circle")
        .attr("class", "search-highlight")
        .attr("r", 29);
    }

    appendAnnotationMarkers(centerGroup, () => current);

    if (evidenceClassForNode(current)) {
      centerGroup
        .append("circle")
        .attr(
          "class",
          `evidence-ring ${evidenceClassForNode(current)}`
        )
        .attr("r", 25);
    }

    if (hasPfamFamilyDirect(current)) {
      centerGroup
        .append("rect")
        .attr("class", "pfam-marker")
        .attr("x", 17)
        .attr("y", -24)
        .attr("width", 13)
        .attr("height", 13)
        .attr("rx", 2);
    }

    centerGroup
      .append("circle")
      .attr("class", "score-ring")
      .attr("r", 20)
      .style(
        "fill",
        nodeFill(current)
      );

    centerGroup
      .append("circle")
      .attr("class", "visible-circle")
      .attr("r", 11);

    centerGroup
      .append("text")
      .attr(
        "class",
        "center-label"
      )
      .attr("x", 0)
      .attr("y", -22)
      .attr(
        "text-anchor",
        "middle"
      )
      .text(
        displayName(current)
      );

    if (children.length === 0) {
      statusEl.textContent =
        "Tento taxon nemá v aktuálním filtru další zobrazené potomky.";

      showInfo(current);
      return;
    }

    const totalWidth =
      (children.length - 1)
      * columnWidth;

    const startX =
      centerX - totalWidth / 2;

    const displayedChildren =
      children.map(
        (child, i) => ({
          data: child,
          x: startX + i * columnWidth,
          y: childY
        })
      );

    group
      .append("g")
      .selectAll("path")
      .data(displayedChildren)
      .join("path")
      .attr(
        "class",
        d =>
          `link ${nodeClass(d.data)}`
      )
      .attr(
        "d",
        d => {
          const midY =
            topY + 60;

          return `
            M ${centerX} ${topY + 11}
            V ${midY}
            H ${d.x}
            V ${d.y - 18}
          `;
        }
      );

    const childNodes =
      group
        .append("g")
        .selectAll("g")
        .data(displayedChildren)
        .join("g")
        .attr(
          "class",
          d => {
            const clickable =
              visibleChildren(d.data).length > 0
                ? " expandable"
                : "";

            return (
              `node ${nodeClass(d.data)}${clickable}`
            );
          }
        )
        .attr(
          "transform",
          d =>
            `translate(${d.x},${d.y})`
        )
        .attr("data-taxid", d => String(d.data.taxid))
        .on(
          "click",
          (event, d) => {
            event.stopPropagation();

            showInfo(
              d.data,
              event.clientY
            );

            if (annotationMode && activeAnnotationId) {
              toggleAnnotationForTaxon(d.data);
              return;
            }

            if (
              visibleChildren(d.data).length > 0
            ) {
              currentTaxid =
                d.data.taxid;

              render();
              resetScrollToTopLeft();
            }
          }
        );

    childNodes
      .append("circle")
      .attr(
        "class",
        "node-hitbox"
      )
      .attr(
        "r",
        23
      );

    childNodes
      .filter(d => Boolean(evidenceClassForNode(d.data)))
      .append("circle")
      .attr(
        "class",
        d => `evidence-ring ${evidenceClassForNode(d.data)}`
      )
      .attr("r", 23);

    childNodes
      .filter(d => hasPfamFamilyDirect(d.data))
      .append("rect")
      .attr("class", "pfam-marker")
      .attr("x", 15)
      .attr("y", -22)
      .attr("width", 12)
      .attr("height", 12)
      .attr("rx", 2);

    childNodes
      .append("circle")
      .attr(
        "class",
        "score-ring"
      )
      .attr(
        "r",
        18
      )
      .style(
        "fill",
        d => nodeFill(d.data)
      );

    childNodes
      .append("circle")
      .attr(
        "class",
        "visible-circle"
      )
      .attr(
        "r",
        d =>
          visibleChildren(d.data).length > 0
            ? 10
            : 8
      );

    childNodes
      .filter(
        d =>
          visibleChildren(d.data).length > 0
      )
      .append("text")
      .attr(
        "class",
        "expand-mark"
      )
      .attr("x", 0)
      .attr("y", 1)
      .text("+");

    childNodes
      .append("text")
      .attr("x", 0)
      .attr("y", 24)
      .attr(
        "text-anchor",
        "middle"
      )
      .text(
        d => {
          const base =
            displayName(d.data);

          if (
            Number(directFilteredHitCount.get(d.data.taxid) || 0) > 0
          ) {
            return (
              `${base} (${Number(directFilteredHitCount.get(d.data.taxid) || 0)})`
            );
          }

          return base;
        }
      );

    statusEl.textContent =
      `${displayName(current)}: ${children.length} přímých potomků`;

    showInfo(current);
  }

  function resetScrollToTopLeft() {
    requestAnimationFrame(() => {
      treeWrap.scrollLeft = 0;
      treeWrap.scrollTop = 0;
    });
  }

  function render() {
    updateBreadcrumb();

    collapseButton.disabled =
      mode !== "explore";

    if (mode === "explore") {
      renderExplore();
    } else {
      renderDrilldown();
    }
  }

  document
    .getElementById("overview-btn")
    .addEventListener(
      "click",
      () => {
        mode = "explore";
        currentTaxid = null;
        render();
        resetScrollToTopLeft();
      }
    );

  collapseButton
    .addEventListener(
      "click",
      () => {
        expandedTaxids.clear();
        mode = "explore";
        render();
        resetScrollToTopLeft();
      }
    );

  backButton
    .addEventListener(
      "click",
      () => {
        if (mode !== "drill") return;

        const parentTaxid =
          parentIndex.get(currentTaxid);

        if (parentTaxid === undefined) {
          mode = "explore";
          currentTaxid = null;
        } else {
          currentTaxid = parentTaxid;
        }

        render();
