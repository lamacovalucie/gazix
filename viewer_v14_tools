    function dist(a,b){return Math.hypot(a.x-b.x,a.y-b.y,a.z-b.z);}

    function pdbAtomLine(serial, atom, xyz, b) {
      const an=atom.atomName.trim().slice(0,4).padStart(4,' ');
      const res=atom.comp.slice(0,3).padStart(3,' ');
      const chain=(atom.chain||'A').slice(0,1);
