  annotationModeInput.addEventListener("change", () => {
    annotationMode = Boolean(annotationModeInput.checked);
    refreshAnnotationControls();

    if (annotationMode && !activeAnnotationId) {
      statusEl.textContent = "Vyber nebo vytvoř štítek a potom klikáním označuj taxony.";
    }
  });

  annotationActiveSelect.addEventListener("change", () => {
    activeAnnotationId = annotationActiveSelect.value;
    const active = annotationStore.labels?.[activeAnnotationId];

    if (active) {
      annotationNameInput.value = active.name || "";
