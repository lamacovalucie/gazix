        if (!tmMod || typeof tmMod.tmAlign !== 'function') throw new Error('Mol* TM-align modul neobsahuje tmAlign().');

        const result = tmMod.tmAlign(refExtract.loci, mobExtract.loci);
        if (!result || !result.alignedLength) throw new Error('TM-align nenašel použitelnou superpozici.');

        const dev=new Map();
        for(let i=0;i<result.alignmentA.length;i++){
          const ia=result.alignmentA[i], ib=result.alignmentB[i];
          const ra=refExtract.ca[ia], rb=mobExtract.ca[ib];
          if(!ra || !rb) continue;
          const d=dist(ra, transformPoint(rb,result.bTransform));
          dev.set(rb.chain+'|'+rb.seq,d);
        }

        const refPdb=makePdb(refExtract,null,new Map(),true);
        const mobPdb=makePdb(mobExtract,result.bTransform,dev,false);
        await viewer.plugin.clear();

        await viewer.loadStructureFromData(refPdb,'pdb',{dataLabel:structureLabel(pair[0],'reference')});
        let rr=roots();
        const refRoot=rr[rr.length-1];
        await viewer.plugin.managers.structure.component.updateRepresentationsTheme(refRoot.components,{color:'uniform',colorParams:{value:0x111111}});

        await viewer.loadStructureFromData(mobPdb,'pdb',{dataLabel:structureLabel(pair[1],'TM-align target')});
        rr=roots();
        const mobRoot=rr[rr.length-1];
        await viewer.plugin.managers.structure.component.updateRepresentationsTheme(mobRoot.components,{color:'uncertainty',colorParams:{domain:[0,8],list:{kind:'interpolate',colors:[0xd8f0dc,0x82c991,0x3f9b5f,0x176b36,0x0b3d1e]}}});

        stats.textContent = 'TM-score ref ' + result.tmScoreA.toFixed(3)
          + ' · TM-score target ' + result.tmScoreB.toFixed(3)
          + ' · RMSD ' + result.rmsd.toFixed(2) + ' Å'
          + ' · aligned ' + result.alignedLength + ' residues';
        setStatus('TM-align hotový. Reference je černá; druhý model jde od tmavě zelené při malé odchylce po světle zelenou při velké odchylce.');
      } catch(e){
        console.error(e);
        setStatus('Compare se nepodařilo: '+e.message,true);
      }
    }
    compare();
  <\/script>
</body>
</html>`;
