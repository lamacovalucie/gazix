  function finiteNumber(value) {
    if (value === null || value === undefined || value === "") return null;
    const number = Number(value);
    return Number.isFinite(number) ? number : null;
  }

  function percentValue(value) {
    const number = finiteNumber(value);
    if (number === null) return null;

    // AlphaFind API občas používá podíl 0–1, export/viewer procenta 0–100.
    // Tímto podporujeme obě reprezentace.
    if (number >= 0 && number <= 1) return number * 100;
    return number;
  }

  function firstMetricValue(hit, keys, percent = false) {
    for (const key of keys) {
      if (!Object.prototype.hasOwnProperty.call(hit || {}, key)) continue;
      const value = percent ? percentValue(hit[key]) : finiteNumber(hit[key]);
      if (value !== null) return value;
    }
    return null;
  }

  function hitMetricValue(hit, metric) {
    if (metric === "tm") {
      return firstMetricValue(hit, [
        "tm_score",
        "tm_score_query",
        "tmScore"
      ]);
    }

    if (metric === "aligned") {
      return firstMetricValue(hit, [
        "aligned_percent",
        "aligned_percentage",
        "aligned_residues",
        "aligned"
      ], true);
    }

    if (metric === "identity") {
      return firstMetricValue(hit, [
        "sequence_identity",
        "sequential_identity",
        "identity_percent",
        "sequence_identity_percent",
        "seq_identity",
        "identity"
      ], true);
    }

    return null;
  }

  function directHits(data) {
    return Array.isArray(data?.hits) ? data.hits : [];
  }

  function hitPassesScoreFilter(hit) {
    if (!scoreFilterEnabled) return true;

    const value = hitMetricValue(hit, scoreFilterMetric);
    return value !== null && value >= scoreFilterThreshold;
  }

  function filteredHitsForNode(data) {
    return directHits(data).filter(hitPassesScoreFilter);
  }

  function computeFilteredAlphaState(node) {
    const ownHits = filteredHitsForNode(node);
    let subtreeCount = ownHits.length;

    let best = null;
    for (const hit of ownHits) {
      const value = hitMetricValue(hit, colorMetric);
      if (value !== null && (best === null || value > best)) best = value;
    }

    for (const child of node.children || []) {
      const childResult = computeFilteredAlphaState(child);
      subtreeCount += childResult.count;
      if (
        childResult.best !== null &&
        (best === null || childResult.best > best)
      ) {
        best = childResult.best;
      }
    }

    directFilteredHitCount.set(node.taxid, ownHits.length);
    subtreeFilteredHitCount.set(node.taxid, subtreeCount);
    subtreeBestScore.set(node.taxid, best);

    return { count: subtreeCount, best };
  }

  function bestScoreForNode(data) {
    if (!data) return null;
    const value = subtreeBestScore.get(data.taxid);
    return value === null || value === undefined ? null : Number(value);
  }

  function scoreColor(value) {
    if (value === null || value === undefined || Number.isNaN(Number(value))) {
      return "#aaa";
    }

    const config = METRIC_CONFIG[colorMetric] || METRIC_CONFIG.tm;
    return d3.scaleLinear()
      .domain(config.colorDomain)
      .range(SCORE_COLORS)
      .clamp(true)(Number(value));
  }

  function updateScoreLegend() {
