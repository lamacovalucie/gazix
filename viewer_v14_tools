  // ============================================================
  // 10. PROJEKTY: DETEKCE, PROJECT.JSON A NAČTENÍ STROMU
  // ============================================================

  function projectNumber(projectId) {
    const match = String(projectId || "")
      .match(/^project(\d+)$/i);

    return match ? Number(match[1]) : Number.POSITIVE_INFINITY;
  }


  async function fetchCurrentProjectId() {
    try {
      const response = await fetch(
        CURRENT_PROJECT_URL,
        { cache: "no-store" }
      );

      if (!response.ok) return null;

      const value = (await response.text()).trim();

      return /^project\d+$/i.test(value)
        ? value.toLowerCase()
        : null;
    }
    catch (error) {
      console.warn(
        "Nepodařilo se načíst current_project.txt:",
        error
      );
      return null;
    }
  }


  async function loadProjectIndex() {
    /*
      Hlavní zdroj pravdy je explicitní:
          data/processed/projects.json

      Viewer tedy nemusí procházet výpis adresáře.
      To je přenositelnější a funguje i na serverech,
      které listing adresářů nepovolují.
    */

    try {
      const response = await fetch(
        PROJECT_INDEX_URL,
        { cache: "no-store" }
      );

      if (!response.ok) {
        throw new Error(
          `${response.status} ${response.statusText}`
        );
      }

      const projects = await response.json();

      if (!Array.isArray(projects)) {
        throw new Error(
          "projects.json není JSON seznam."
        );
      }

      return projects
        .filter(
          project =>
            /^project\d+$/i.test(
              String(
                project?.project_id || ""
              )
            )
        )
        .sort(
          (a, b) =>
            projectNumber(a.project_id)
            - projectNumber(b.project_id)
        );
    }
    catch (error) {
      console.warn(
        "Nepodařilo se načíst projects.json:",
        error
      );

      /*
        Fallback pro starší projektovou strukturu:
        pokud index ještě není vytvořený, zkusíme alespoň
        current_project.txt, aby viewer nebyl úplně nepoužitelný.
      */
      const currentId =
        await fetchCurrentProjectId();

      if (!currentId) {
        return [];
      }

      return [
        {
          project_id: currentId,
          name: currentId,
          tree_json: "alphafind_tree.json"
        }
      ];
    }
  }


  async function loadProjectMeta(projectId) {
    const url =
      `${PROCESSED_ROOT_URL}${projectId}/project.json`;

    try {
      const response = await fetch(
        url,
        { cache: "no-store" }
      );

      if (!response.ok) {
        throw new Error(
          `${response.status} ${response.statusText}`
        );
      }

      const meta = await response.json();

      return {
        project_id: meta.project_id || projectId,
        name: meta.name || projectId,
        input_csv: meta.input_csv || null,
        created_at: meta.created_at || null,
        tree_json: meta.tree_json || "alphafind_tree.json",
        panther: meta.panther || null,
        pfam: meta.pfam || null,
        query_uniprot: meta.query_uniprot || meta.query_accession || meta.query_protein_id || meta.query_id || null,
        query_protein_name: meta.query_protein_name || meta.query_name || null,
        query_organism: meta.query_organism || meta.query_taxon_name || meta.organism || null
      };
    }
    catch (error) {
      console.warn(
        `project.json pro ${projectId} se nepodařilo načíst:`,
        error
      );

      return {
        project_id: projectId,
        name: projectId,
        input_csv: null,
        created_at: null,
        tree_json: "alphafind_tree.json",
        panther: null,
        pfam: null,
        query_uniprot: null,
        query_protein_name: null,
        query_organism: null
      };
    }
  }


  function resetViewerState() {
    originalData = null;
    mode = "explore";
    currentTaxid = null;
    selectedTaxid = null;
    searchedTaxid = null;
    searchRevealTaxids.clear();

    expandedTaxids.clear();
    nodeIndex.clear();
    parentIndex.clear();
    directFilteredHitCount.clear();
    subtreeFilteredHitCount.clear();
    subtreeBestScore.clear();
