    async function loadTmAlignModule() {
      try {
        return await import('https://esm.sh/molstar@5.11.0/lib/mol-model/structure/structure/util/tm-align.js');
      } catch (e) {
        throw new Error('Nepodařilo se načíst TM-align modul Mol*: ' + e.message);
      }
    }

    async function compare() {
      try {
        viewer=await molstar.Viewer.create('molstar-root',{
          layoutIsExpanded:false,layoutShowControls:true,layoutShowRemoteState:false,layoutShowSequence:true,
          layoutShowLog:true,layoutShowLeftPanel:true,viewportShowExpand:true,viewportShowSelectionMode:true,viewportShowAnimation:true
        });

        setStatus('Načítám oba AlphaFold modely…');
        const entries=await Promise.all(pair.map(function(x){ return afEntry(x.accession); }));
        for(let i=0;i<2;i++){
          const e=entries[i];
          const url=e.cifUrl||e.cif_url||e.modelCifUrl||e.model_cif_url;
          await viewer.loadStructureFromUrl(url,'mmcif',false,{label:structureLabel(pair[i],'')});
        }

        const r=roots();
        if(r.length<2) throw new Error('Mol* nenačetl oba modely.');
        const refExtract=extractAtomsAndCaLoci(r[r.length-2].cell.obj.data);
        const mobExtract=extractAtomsAndCaLoci(r[r.length-1].cell.obj.data);
        if(refExtract.ca.length<3 || mobExtract.ca.length<3) throw new Error('Nedostatek Cα atomů pro TM-align.');

