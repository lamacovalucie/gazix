    }
  });

  annotationSaveButton.addEventListener("click", () => {
    const name = String(annotationNameInput.value || "").trim();
    if (!name) {
      statusEl.textContent = "Nejdřív napiš název štítku.";
      return;
    }

    let id = activeAnnotationId;
    if (!id || !annotationStore.labels?.[id]) {
      id = nextAnnotationId();
    }

    annotationStore.labels[id] = {
      name,
      color: annotationColorInput.value || "#2f80ed"
    };

    activeAnnotationId = id;
    saveAnnotations();
    refreshAnnotationControls();
    computeSubtreeAnnotations(originalData);
    render();
    statusEl.textContent = `Štítek „${name}“ je uložený.`;
  });

  annotationDeleteButton.addEventListener("click", () => {
    if (!activeAnnotationId || !annotationStore.labels?.[activeAnnotationId]) return;

    const name = annotationStore.labels[activeAnnotationId].name || activeAnnotationId;
    const deletedId = activeAnnotationId;

    delete annotationStore.labels[deletedId];

    for (const [taxid, ids] of Object.entries(annotationStore.assignments || {})) {
      const remaining = (Array.isArray(ids) ? ids : []).filter(id => id !== deletedId);
      if (remaining.length) annotationStore.assignments[taxid] = remaining;
      else delete annotationStore.assignments[taxid];
    }

    if (annotationFilterId === deletedId) annotationFilterId = "";
    activeAnnotationId = "";
    annotationNameInput.value = "";

    saveAnnotations();
    computeSubtreeAnnotations(originalData);
    refreshAnnotationControls();
    render();
    statusEl.textContent = `Štítek „${name}“ byl smazán.`;
