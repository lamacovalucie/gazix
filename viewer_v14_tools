  async function loadPantherEvidence(projectId, projectMeta) {
    const configuredPath =
      projectMeta?.panther?.evidence_json
      || "panther/panther_evidence.json";

    currentPantherUrl =
      `${PROCESSED_ROOT_URL}${projectId}/${configuredPath}`;

    try {
      const response = await fetch(
        currentPantherUrl,
        { cache: "no-store" }
      );

      if (!response.ok) {
        if (response.status !== 404) {
          console.warn(
            `PANTHER evidence pro ${projectId}:`,
            `${response.status} ${response.statusText}`
          );
        }
        return null;
      }

      return await response.json();
    }
    catch (error) {
      console.warn(
        `PANTHER evidence pro ${projectId} se nepodařilo načíst:`,
        error
      );
      return null;
    }
  }


  function indexPantherEvidence(evidence) {
    pantherByTaxid.clear();

    const taxa =
      evidence && typeof evidence.taxa === "object"
        ? evidence.taxa
        : {};

    for (const [taxidText, value] of Object.entries(taxa)) {
      const taxid = Number(value?.taxid ?? taxidText);

      if (!Number.isFinite(taxid)) continue;

      pantherByTaxid.set(
        taxid,
        { ...value, taxid }
      );
    }

    pantherMatchedTaxa = 0;
    pantherUnmatchedTaxa = 0;

    for (const taxid of pantherByTaxid.keys()) {
      if (nodeIndex.has(taxid)) {
        pantherMatchedTaxa += 1;
      } else {
        pantherUnmatchedTaxa += 1;
      }
    }

    const coverageNote =
      document.getElementById("panther-coverage-note");

    if (coverageNote) {
      if (pantherByTaxid.size === 0) {
        coverageNote.textContent =
          "PANTHER evidence pro tento projekt není načtená.";
      } else {
        coverageNote.textContent =
          `PANTHER: ${pantherMatchedTaxa}/${pantherByTaxid.size} taxonů `
          + `je už přítomno v tomto taxonomickém stromu. `
          + `${pantherUnmatchedTaxa} PANTHER taxonů zatím ve stromu chybí.`;
      }
    }
  }


  async function loadPfamEvidence(projectId, projectMeta) {
    const configuredPath =
      projectMeta?.pfam?.evidence_json
      || "pfam/pfam_evidence.json";

    currentPfamUrl =
      `${PROCESSED_ROOT_URL}${projectId}/${configuredPath}`;

    try {
      const response = await fetch(currentPfamUrl, { cache: "no-store" });
      if (!response.ok) {
        if (response.status !== 404) {
          console.warn(`Pfam evidence pro ${projectId}:`, `${response.status} ${response.statusText}`);
        }
        return null;
      }
      return await response.json();
    } catch (error) {
      console.warn(`Pfam evidence pro ${projectId} se nepodařilo načíst:`, error);
      return null;
    }
  }

  function indexPfamEvidence(evidence) {
    pfamByTaxid.clear();

    const taxa = evidence && typeof evidence.taxa === "object"
      ? evidence.taxa
      : {};

    for (const [taxidText, value] of Object.entries(taxa)) {
      const taxid = Number(value?.taxid ?? taxidText);
      if (!Number.isFinite(taxid)) continue;
      pfamByTaxid.set(taxid, { ...value, taxid });
    }

    pfamMatchedTaxa = 0;
    pfamUnmatchedTaxa = 0;
    for (const taxid of pfamByTaxid.keys()) {
      if (nodeIndex.has(taxid)) pfamMatchedTaxa += 1;
      else pfamUnmatchedTaxa += 1;
    }

    const note = document.getElementById("pfam-coverage-note");
    if (note) {
      if (pfamByTaxid.size === 0) {
        note.textContent = "Pfam evidence pro tento projekt není načtená.";
      } else {
        const label = evidence?.pfam_id ? `Pfam ${evidence.pfam_id}` : "Pfam";
        note.textContent =
          `${label}: ${pfamMatchedTaxa}/${pfamByTaxid.size} taxonů je přítomno ve stromu. `
          + `${pfamUnmatchedTaxa} Pfam taxonů ve stromu chybí.`;
      }
    }
  }


  async function loadProject(projectId) {
    resetViewerState();

    currentProjectId = projectId;
    currentProjectMeta =
      await loadProjectMeta(projectId);

    const treeFile =
      currentProjectMeta.tree_json
      || "alphafind_tree.json";

    currentDataUrl =
      `${PROCESSED_ROOT_URL}${projectId}/${treeFile}`;

    statusEl.textContent =
      `Načítám ${currentProjectMeta.name}…`;

    document.title =
      `${currentProjectMeta.name} – AlphaFind + PANTHER + Pfam Taxonomy Viewer`;

    try {
      const [data, pantherEvidence, pfamEvidence] =
        await Promise.all([
          d3.json(currentDataUrl),
          loadPantherEvidence(projectId, currentProjectMeta),
          loadPfamEvidence(projectId, currentProjectMeta)
        ]);

      originalData = data;
      currentPantherEvidence = pantherEvidence;
      currentPfamEvidence = pfamEvidence;

      indexTree(originalData);
      refreshOrganismSearchList();
      loadAnnotations();
      loadTaxonNotes();
      scoreFilterEnabled = Boolean(scoreFilterEnabledInput.checked);
      scoreFilterMetric = scoreFilterMetricSelect.value;
      colorMetric = colorMetricSelect.value;
      scoreFilterThreshold = finiteNumber(scoreFilterThresholdInput.value)
        ?? METRIC_CONFIG[scoreFilterMetric].defaultThreshold;
      updateScoreLegend();
      computeFilteredAlphaState(originalData);
      indexPantherEvidence(currentPantherEvidence);
      computeSubtreePanther(originalData);
      indexPfamEvidence(currentPfamEvidence);
      computeSubtreePfam(originalData);
      computeSubtreeAlphaOnly(originalData);
      computeSubtreeAlphaOutsidePfam(originalData);

      mode = "explore";
      viewFilter = viewFilterSelect.value;
      labelMode = labelModeSelect.value;

      render();
      resetScrollToTopLeft();

      /*
        render() nastaví stav typu "Viditelné uzly: ...".
        Přidáme před něj lidský název projektu.
      */
      const pantherStatus =
        pantherByTaxid.size > 0
          ? ` · PANTHER ${pantherMatchedTaxa}/${pantherByTaxid.size} taxonů mapováno`
          : "";
      const pfamStatus =
        pfamByTaxid.size > 0
          ? ` · Pfam ${pfamMatchedTaxa}/${pfamByTaxid.size} taxonů mapováno`
          : "";

      statusEl.textContent =
        `${currentProjectMeta.name} · ${statusEl.textContent}${pantherStatus}${pfamStatus}`;
    }
    catch (error) {
      console.error(error);

      errorEl.style.display = "block";

      errorEl.textContent = `
Nepodařilo se načíst projekt:

${currentProjectMeta?.name || projectId}

Technické ID:
${projectId}

Očekávaný strom:
${currentDataUrl}

Spusť server z kořene projektu NCBR:

python3 -m http.server 8000

Potom otevři:

http://localhost:8000/viewer/tree_viewer.html

Technická chyba:

${error}
      `;
    }
  }


  async function initialiseProjects() {
    const indexedProjects = await loadProjectIndex();
    const currentId = await fetchCurrentProjectId();

    const projectIds =
      indexedProjects.map(
        project =>
          String(project.project_id).toLowerCase()
      );

    projectSelect.innerHTML = "";

    if (projectIds.length === 0) {
      const option = document.createElement("option");
      option.value = "";
      option.textContent = "Žádný projekt";
      projectSelect.appendChild(option);
      projectSelect.disabled = true;

      errorEl.style.display = "block";
      errorEl.textContent = `
Nenašla jsem žádný projekt v:

data/processed/projects.json

Nejdřív zpracuj AlphaFind CSV pomocí TreeRun.sh.
tree.py vytvoří/aktualizuje index automaticky.
      `;
      return;
    }

    const projectMetas = await Promise.all(
      indexedProjects.map(
        async indexedProject => {
          const projectId =
            String(
              indexedProject.project_id
            ).toLowerCase();

          /*
            project.json zůstává detailní metadata konkrétního projektu.
            projects.json je index. Když se oba podaří načíst,
            project.json může dodat aktuálnější lidský název.
          */
          const fileMeta =
            await loadProjectMeta(projectId);

          return {
            projectId,
            meta: {
              ...indexedProject,
              ...fileMeta
            }
          };
        }
      )
    );

    for (const { projectId, meta } of projectMetas) {
      const option = document.createElement("option");

      option.value = projectId;
      option.textContent =
        meta.name === projectId
          ? projectId
          : `${meta.name} (${projectId})`;

      projectSelect.appendChild(option);
    }

    const initialProjectId =
      currentId && projectIds.includes(currentId)
        ? currentId
        : projectIds[0];

    projectSelect.value = initialProjectId;
    projectSelect.disabled = false;

    await loadProject(initialProjectId);
  }


  projectSelect.addEventListener(
    "change",
    async () => {
      const projectId = projectSelect.value;
      if (!projectId) return;

      await loadProject(projectId);
    }
  );


  updateFilterInputForMetric(false);
  updateScoreLegend();
  initialiseProjects();


  // ============================================================
  // POSOUVÁNÍ MYŠÍ: KLIKNI + TÁHNI
  // ============================================================

  /*
    Používáme klasické mouse events místo pointer capture.
    Na desktopu je to pro scrollovací SVG spolehlivější
    a funguje stejně vodorovně i svisle.
  */

  let mouseIsDown = false;
  let isPanning = false;
  let panStartX = 0;
  let panStartY = 0;
  let panStartScrollLeft = 0;
  let panStartScrollTop = 0;
  let suppressNextClick = false;

  treeWrap.addEventListener(
    "mousedown",
    event => {
      if (event.button !== 0) return;

      mouseIsDown = true;
      isPanning = false;
      suppressNextClick = false;

      panStartX = event.clientX;
      panStartY = event.clientY;

      panStartScrollLeft =
        treeWrap.scrollLeft;

      panStartScrollTop =
        treeWrap.scrollTop;

      /*
        Default zatím NEblokujeme. Obyčejný klik musí
        zůstat kliknutím. preventDefault() použijeme
        až ve chvíli, kdy skutečně táhneme.
      */
    }
  );

  window.addEventListener(
    "mousemove",
    event => {
      if (!mouseIsDown) return;

      const dx =
        event.clientX - panStartX;

      const dy =
        event.clientY - panStartY;

      /*
        Teprve po malém pohybu začneme gesture chápat jako drag.
        Obyčejný klik na uzel tedy zůstane kliknutím.
      */
      if (
        !isPanning &&
        (
          Math.abs(dx) > 4 ||
          Math.abs(dy) > 4
        )
      ) {
        isPanning = true;
        suppressNextClick = true;

        treeWrap.classList.add(
          "dragging"
        );
      }

      if (!isPanning) return;

      /*
        dx řeší pohyb vlevo/vpravo,
        dy řeší pohyb nahoru/dolů.
      */
      treeWrap.scrollLeft =
        panStartScrollLeft - dx;

      treeWrap.scrollTop =
        panStartScrollTop - dy;

      event.preventDefault();
    }
  );

  function stopPanning() {
    mouseIsDown = false;
    isPanning = false;

    treeWrap.classList.remove(
      "dragging"
    );
  }

  window.addEventListener(
    "mouseup",
    stopPanning
  );

  window.addEventListener(
    "blur",
    stopPanning
  );

  /*
    Pokud uživatel strom opravdu táhl,
    browser někdy po puštění myši ještě vyšle click.
    Ten jednorázově zahodíme, aby se omylem
    nerozbalil uzel pod kurzorem.
  */
  treeWrap.addEventListener(
    "click",
    event => {
      if (suppressNextClick) {
        event.preventDefault();
        event.stopPropagation();

        suppressNextClick = false;
      }
    },
    true
  );

  window.addEventListener(
    "resize",
    () => {
      if (originalData) {
        render();
      }
    }
  );
</script>
