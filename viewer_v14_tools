      const xs=xyz.x.toFixed(3).padStart(8,' '), ys=xyz.y.toFixed(3).padStart(8,' '), zs=xyz.z.toFixed(3).padStart(8,' ');
      const bf=Math.max(0,Math.min(99.99,Number(b)||0)).toFixed(2).padStart(6,' ');
      const elem=(atom.elem||'C').trim().slice(0,2).padStart(2,' ');
      return 'ATOM  '+String(serial).slice(-5).padStart(5,' ')+' '+an+' '+res+' '+chain+seq+'    '+xs+ys+zs+'  1.00'+bf+'          '+elem;
    }

    function makePdb(extracted, matrix, deviationMap, isReference) {
      const lines=[]; let serial=1;
      for(const atom of extracted.atoms){
        const xyz=isReference ? atom : transformPoint(atom,matrix);
        const key=atom.chain+'|'+atom.seq;
        const b=isReference ? 0 : (deviationMap.has(key) ? deviationMap.get(key) : 9.5);
