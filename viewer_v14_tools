        loc.unit = unit;
        const indices = [];
        if (!unit.elements || !unit.conformation) continue;

        for (let i = 0; i < unit.elements.length; i++) {
          const e = unit.elements[i];
          loc.element = e;
          let atomName, comp, chain, seq, elem;
          try {
            atomName = P.atom.label_atom_id(loc);
            comp = P.atom.label_comp_id(loc);
            chain = P.chain.auth_asym_id(loc) || P.chain.label_asym_id(loc) || 'A';
            seq = P.residue.auth_seq_id(loc) || P.residue.label_seq_id(loc);
            elem = P.atom.type_symbol(loc) || String(atomName || '').replace(/[^A-Za-z]/g,'').slice(0,2);
